# Discord Bot Token (Get from: https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Optional: Set to a specific guild ID for instant slash-command syncing while
# developing. Only takes effect when DEBUG_MODE=true — otherwise commands sync
# globally (production behaviour).
GUILD_ID=None

# Set to true only while developing/testing (enables dev-mode guild sync)
DEBUG_MODE=false

# Weather API Key (Get from: https://openweathermap.org/api)
WEATHER_API_KEY=your_weather_api_key_here

# Database Configuration (SQLite by default)
DATABASE_URL=sqlite:///cereal.db

# Address the health check server binds to. Keep 127.0.0.1 unless you need
# external uptime monitoring (then also map port 8080 in docker-compose.yml).
# PaaS platforms (Render, Heroku, ...) export PORT and take precedence —
# when PORT is set, the health server binds 0.0.0.0:$PORT with a minimal
# public payload (details stay on loopback for the Docker healthcheck).
HEALTH_HOST=127.0.0.1
